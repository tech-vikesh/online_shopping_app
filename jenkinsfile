pipeline {

    agent any

    stages {

        stage("Code") {
            steps {
                git url: "https://github.com/tech-vikesh/online_shopping_app.git", branch: "master"
            }
        }

        stage("Build") {
            steps {
                echo "Building.."
                sh "docker build -t online_shop ."
            }
        }
        stage("Test") {
            steps {
                echo "Testing.."
            }
        }

        stage("Deploy") {
            steps {
                echo "Deploying.."
                sh "docker compose up -d --build online_shop"
            }
        }

    }
}
